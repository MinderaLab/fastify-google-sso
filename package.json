{
  "name": "fastify-google-sso",
  "version": "1.0.0",
  "description": "A drop-in Fastify plugin for gating admin/human-facing routes behind Google login, restricted by a Workspace domain or an email allowlist.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinderaLab/fastify-google-sso.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": ["fastify", "google", "oauth2", "sso", "plugin"],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/oauth2": "^8.3.0",
    "fastify-plugin": "^6.0.0",
    "google-auth-library": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "fastify": "^5.12.5",
    "typescript": "^5.6.3"
  }
}
