{
  "name": "fastify-google-sso",
  "version": "1.3.0",
  "description": "Google login for admin/human-facing pages, restricted by a Workspace domain, an email allowlist, or Google Group membership: a drop-in Fastify plugin plus a framework-neutral core.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinderaLab/fastify-google-sso.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "fastify",
    "google",
    "oauth2",
    "sso",
    "plugin"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "fastify-plugin": "^6.0.0",
    "google-auth-library": "^11.1.0"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.1.2",
    "@types/node": "^22.9.0",
    "fastify": "^5.12.5",
    "typescript": "^5.6.3"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  }
}
